# TEMPLATE ONLY — this file IS committed to git. Never put real values here.
# Copy it to .env.local (or .env) and fill those in; both are gitignored.

# Production origin. Drives canonical URLs, sitemap entries and JSON-LD @ids.
# Falls back to the Vercel domain when unset. Only switch to the custom domain
# once it is registered AND pointing at Vercel.
NEXT_PUBLIC_SITE_URL=https://sr-conservation-restoration-web.vercel.app

# Contact form (Resend). Without these two the form fails gracefully and tells
# the visitor to email directly.
# No NEXT_PUBLIC_ prefix on the key — that would ship it to the browser.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
CONTACT_TO_EMAIL=

# Sender address. The free Resend tier only allows onboarding@resend.dev until a
# domain is verified; after verifying, switch to something like hola@dominio.pe.
CONTACT_FROM_EMAIL=onboarding@resend.dev
